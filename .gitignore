# Configurarea reala, cu parole. Se creeaza din config.example.php la instalare.
/config/config.php

# Imaginile incarcate de client. Se sincronizeaza separat, nu prin git.
/public_html/uploads/*
!/public_html/uploads/.gitkeep

# Dependinte JS — folosite doar local, pentru a construi bundle-ul editorului.
# Bundle-ul rezultat SE COMITE (nu exista pas de build pe server).
/node_modules/

# Fisiere de lucru
*.log
.DS_Store
Thumbs.db

# Skill-uri instalate prin npx skills / impeccable — tooling, nu fac parte din site.
# Pastram .claude/settings.local.json (hook-urile), dar nu si skill-urile vendorizate.
/.agents/
/.codex/
/skills-lock.json
/.claude/skills/

# Dependinte JS pentru build (esbuild + TipTap). Bundle-ul rezultat SE comite.
/package-lock.json
