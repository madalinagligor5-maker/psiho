---
import { getCollection } from 'astro:content';
import Pagina from '../layouts/Pagina.astro';

export async function getStaticPaths() {
  const pag = await getCollection('pagini');
  return pag.map((x) => ({ params: { pagina: x.slug }, props: { x } }));
}

const { x } = Astro.props;
const { Content } = await x.render();
const descrieri = {
  confidentialitate: 'Cum prelucrează cristinaadam.ro datele transmise prin formularele de contact și newsletter și ce drepturi ai conform GDPR.',
  cookies: 'Informații clare despre cookies și serviciile externe folosite pe cristinaadam.ro.',
  termeni: 'Condițiile de utilizare pentru cristinaadam.ro și informații despre programări, conținut și limitarea răspunderii.',
};
---
<Pagina titlu={`${x.data.titlu} | Adam Cristina`} descriere={descrieri[x.slug] || x.data.titlu}>
  <div class="proza-wrap">
    <article class="proza">
      <h1>{x.data.titlu}</h1>
      <Content />
    </article>
  </div>
</Pagina>
