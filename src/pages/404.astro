---
import Pagina from '../layouts/Pagina.astro';
---
<Pagina titlu="Pagină negăsită | Adam Cristina" descriere="Pagina căutată nu există sau a fost mutată.">
  <section class="wrap head" style="min-height:55vh">
    <p class="eyebrow">Eroare 404</p>
    <h1>Pagina căutată nu este aici.</h1>
    <p class="muted" style="max-width:52ch;margin-top:1rem">Poate că adresa s-a schimbat sau linkul nu mai este actual. Poți reveni la pagina principală ori poți citi articolele.</p>
    <p style="margin-top:1.5rem"><a class="btn" href="/">Înapoi la pagina principală</a> <a class="inapoi" href="/articole" style="margin-left:1rem">Vezi articolele</a></p>
  </section>
</Pagina>
