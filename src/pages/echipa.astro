---
import { getCollection } from 'astro:content';
import Pagina from '../layouts/Pagina.astro';

const membri = (await getCollection('echipa')).sort((a, b) => a.data.ordine - b.data.ordine);
const rendered = await Promise.all(
  membri.map(async (m) => ({ data: m.data, Content: (await m.render()).Content }))
);
---
<Pagina titlu="Cine suntem — Adam și Babotan" descriere="Cristina și Amalia, psihologe în Timișoara. Formare, specializări și codul CPR, verificabil la Colegiul Psihologilor.">
  <section class="wrap head">
    <p class="eyebrow">Cine suntem</p>
    <h1>Cristina și Amalia</h1>
    <p class="muted" style="max-width:60ch; margin-top:1rem">
      Lucrăm împreună, sub forma cabinetului ADAM și BABOTAN, în Timișoara. Mai jos e povestea
      fiecăreia: formarea, specializările și codul CPR, verificabil în registrul Colegiului
      Psihologilor din România.
    </p>
  </section>
  {rendered.map(({ data, Content }) => (
    <section class="wrap membru">
      <h2>{data.nume}</h2>
      <p class="rol">{data.titlu}</p>
      <p class="acred">
        Cod CPR <strong>{data.cpr}</strong>
        {data.judet && <> · Filiala {data.judet}</>}
        {' · '}{data.regim === 'autonom' ? 'regim autonom' : 'sub supervizare'}
      </p>
      <div class="proza"><Content /></div>
    </section>
  ))}
</Pagina>
