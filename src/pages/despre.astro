---
import { getEntry } from 'astro:content';
import Pagina from '../layouts/Pagina.astro';

const profil = await getEntry('echipa', '1-cristina');
if (!profil) throw new Error('Profilul Adam Cristina lipsește din colecția de conținut.');
const { Content } = await profil.render();
const { nume, titlu, cpr, judet, regim } = profil.data;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': 'https://cristinaadam.ro/#cristina-adam',
  name: nume,
  url: 'https://cristinaadam.ro/despre',
  image: 'https://cristinaadam.ro/assets/images/adam-cristina-psiholog.jpeg',
  jobTitle: 'Psiholog clinician',
  description: 'Psiholog clinician autonom în Timișoara, cu formare sistemică, Cercul Siguranței, TBRI și evaluarea personalității.',
  knowsAbout: [
    'Psihologie clinică',
    'Psihoterapie sistemică de familie și cuplu',
    'Cercul Siguranței pentru părinți',
    'Trust-Based Relational Intervention (TBRI)',
    'Evaluarea personalității',
    'Inventarul de personalitate Big Five Plus',
  ],
  telephone: '+40787541193',
  memberOf: {
    '@type': 'Organization',
    name: 'Colegiul Psihologilor din România',
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Universitatea de Vest din Timișoara',
  },
};
---
<Pagina titlu="Adam Cristina · psiholog clinician în Timișoara" descriere="Psiholog clinician autonom în Timișoara, cu formare sistemică, Cercul Siguranței, TBRI și competențe în evaluarea personalității." schema={schema}>
  <section class="wrap head profil-head profil-intro">
    <div>
      <p class="eyebrow">Despre mine</p>
      <h1>{nume}</h1>
      <p class="lead muted">
        Psiholog clinician autonom și consilier școlar. Lucrez cu adulți, copii și părinți,
        iar în ședințe privim atât dificultatea de acum, cât și contextul în care se menține.
      </p>
    </div>
    <figure class="profil-portret">
      <img src="/assets/images/adam-cristina-psiholog.jpeg" width="1254" height="1254" alt="Adam Cristina, psiholog clinician în Timișoara" />
    </figure>
  </section>
  <article class="wrap membru profil-card">
    <header>
      <p class="rol">{titlu}</p>
      <p class="acred">
        Adam Nicoleta Cristina · Cod CPR <strong>{cpr}</strong>
        {judet && <> · Filiala {judet}</>}
        {' · '}{regim === 'autonom' ? 'regim autonom' : regim}
      </p>
    </header>
    <div class="proza"><Content /></div>
  </article>
</Pagina>
