---
import { getCollection } from 'astro:content';
import Pagina from '../../layouts/Pagina.astro';
const arts = (await getCollection('articole')).sort(
  (a, b) => (b.data.data || '').localeCompare(a.data.data || '')
);
const formatData = (data) => data
  ? new Intl.DateTimeFormat('ro-RO', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(`${data}T12:00:00`))
  : '';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Articole de psihologie — Adam Cristina',
  url: 'https://cristinaadam.ro/articole/',
  inLanguage: 'ro-RO',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: arts.map((a, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: `https://cristinaadam.ro/articole/${a.slug}/`,
      name: a.data.titlu,
    })),
  },
};
---
<Pagina titlu="Articole de psihologie | Adam Cristina, Timișoara" descriere="Articole scrise de Adam Cristina despre anxietate, epuizare, relații și parenting, explicate clar și fără promisiuni simpliste." schema={schema}>
  <section class="wrap head">
    <p class="eyebrow">Psihologie, pe înțeles</p>
    <h1>Articole despre relații, emoții și parenting</h1>
    <p class="muted" style="max-width:62ch;margin-top:1rem">Texte care te ajută să recunoști un mecanism și să formulezi întrebări mai bune. Nu înlocuiesc evaluarea sau ședințele individuale.</p>
  </section>
  <div class="wrap">
    <ul class="lista">
      {arts.map((a) => (
        <li>
          <a class="art-card" href={`/articole/${a.slug}`}>
            {a.data.imagine && <img class="art-card__img" src={a.data.imagine} alt={a.data.imagineAlt || ''} width="1536" height="1024" loading="lazy" />}
            <span class="art-card__body">
              {a.data.categorie && <span class="cat">{a.data.categorie}</span>}
              {a.data.data && <span class="meta"><time datetime={a.data.data}>{formatData(a.data.data)}</time> · Adam Cristina</span>}
              <h2>{a.data.titlu}</h2>
              <span class="art-card__rezumat">{a.data.rezumat}</span>
              <span class="mai">Citește articolul →</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Pagina>
